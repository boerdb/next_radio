# Bens Web Radio Live
# HTTP op het LAN → directe interne stream
# HTTPS-app (wifi en mobiel) → /api/live-stream naar diezelfde interne stream
LIVE_STREAM_INTERNAL_BASE=http://192.168.1.81:8000/radio
NEXT_PUBLIC_LIVE_STREAM_DIRECT=http://192.168.1.81:8000/radio
# Optioneel als metadata elders staat:
# LIVE_METADATA_URL=http://192.168.1.81:8000/radio/metadata

OPENWEATHER_API_KEY=your_openweather_api_key_here
